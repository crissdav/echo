# ============================================================
#  Echo — variables de entorno
#  Copia este archivo como .env y completa los valores.
#  El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ============================================================

APP_NAME=Echo
APP_ENV=production
APP_DEBUG=false
# URL pública (IP elástica o dominio), sin "/" final
APP_URL=http://TU-IP-ELASTICA

# ---------- Base de datos (Amazon RDS for MySQL) ----------
# Punto de enlace del RDS (Consola RDS > Bases de datos > echo-db > Conectividad)
DB_HOST=echo-db.xxxxxxxxxxxx.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=echo
# Usuario de la aplicación con privilegios mínimos (no el usuario maestro "admin")
DB_USER=echo_app
DB_PASS=CambiaEstaClave_2026
# Certificado de AWS para cifrar la conexión con TLS (lo descarga deploy/setup.sh).
# Déjalo vacío solo en desarrollo local.
DB_SSL_CA=/etc/ssl/certs/rds-global-bundle.pem

# ---------- Almacenamiento de imágenes ----------
# s3    = Amazon S3 (producción, usa el rol IAM de la EC2; NO se ponen claves aquí)
# local = carpeta storage/uploads (solo para pruebas locales)
STORAGE_DRIVER=s3
AWS_REGION=us-east-2
S3_BUCKET=echo-media-crissdav
# Segundos de validez de las URL prefirmadas
S3_URL_TTL=7200

# Muestra el usuario demo en la pantalla de login (útil para que el docente pruebe)
SHOW_DEMO_LOGIN=true
